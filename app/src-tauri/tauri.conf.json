{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundBimba",
  "version": "0.5.0",
  "identifier": "io.github.spicelnr.soundbimba",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SoundBimba",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "publisher": "SoundBimba contributors",
    "copyright": "AGPL-3.0-or-later",
    "shortDescription": "Sound routing map for Windows",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English",
          "Ukrainian"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "SoundBimba",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "bmb"
        ],
        "name": "SoundBimba template",
        "description": "SoundBimba template",
        "role": "Editor",
        "mimeType": "application/x-soundbimba-template"
      }
    ]
  }
}
